# VoiceGuard — Environment Variables
# Copy this file to .env and fill in values as needed.
# All values here are the same as the built-in defaults; only set a variable
# if you want to override the default.

# ── Server ────────────────────────────────────────────────────────────────
VOICEGUARD_HOST=0.0.0.0
VOICEGUARD_PORT=8000

# ── Audio ─────────────────────────────────────────────────────────────────
# Duration of each real-time chunk sent to the AI detector in Phase 2.
CHUNK_DURATION_SECONDS=2.0

# Fallback sample rate used if Exotel start event is missing this field.
DEFAULT_SAMPLE_RATE=8000

# ── Filesystem ────────────────────────────────────────────────────────────
# Absolute or relative paths (relative = relative to backend/).
# RECORDINGS_DIR=recordings
# CHUNKS_DIR=chunks

# ── Logging ───────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ── Throttling ────────────────────────────────────────────────────────────
# Print audio progress every N packets (Exotel sends ~50 packets/sec).
AUDIO_LOG_EVERY_N_PACKETS=50
